struct CapBinding(target: entity, enabled: bool, revision: i32)
struct CapState(phase: i32, appliedRevision: i32, generation: i32, message: string)
struct CapType(component: string, category: string, description: string)
struct CapReadback(x: f32, y: f32, z: f32, vx: f32, vy: f32, vz: f32, contacts: i32)
CapDependsOn {}
CapDirty {}
struct CapBody(mass: f32, radius: f32, height: f32, gravity: f32, kinematic: bool)
