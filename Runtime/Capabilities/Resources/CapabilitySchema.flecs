struct CapWeather(hour: i32, minute: i32, cloud: i32, weather: string)
struct CapWater(level: f32, density: f32)
struct CapBuoyancy(volume: entity, displacement: f32, drag: f32)
struct CapHandle(radius: f32, grid: f32, enabled: bool, edit: entity, component: string, index: i32)
struct CapSequence(pattern: string, bpm: f32, playing: bool)

struct CapNavSurface(radius: f32, height: f32, rebuild: i32)
struct CapPath(x: f32, y: f32, z: f32, status: i32)

struct CapOcean(prefab: string, level: f32)

